{
  "name": "Atelier - Ingesteur Audiovisuel & PDF (Local)",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "folder",
        "path": "/home/daniel/projets-agentiques/Atelier-Agentique-Editorial/data/01_inbox",
        "events": [
          "add"
        ],
        "options": {
          "awaitWriteFinish": true,
          "followSymlinks": false,
          "ignoreInitial": true,
          "depth": 0,
          "usePolling": true
        }
      },
      "id": "77afcb47-b88b-4df2-8888-e4022d4d90f4",
      "name": "Surveillance Inbox",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [
        0,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst root = \"/home/daniel/projets-agentiques/Atelier-Agentique-Editorial/data\";\nconst inbox = root + \"/01_inbox/\";\nconst items = $input.all();\nconst result = [];\n\nif (items.length === 0) {\n  throw new Error(\"Aucune donnée reçue du déclencheur.\");\n}\n\nfor (const [index, item] of items.entries()) {\n  const event = item.json.event;\n  const path = item.json.path;\n\n  if (event !== \"add\") {\n    throw new Error(\n      \"Événement inattendu : \" + String(event)\n    );\n  }\n\n  if (typeof path !== \"string\") {\n    throw new Error(\"Chemin du fichier absent ou invalide.\");\n  }\n\n  if (!path.startsWith(inbox)) {\n    throw new Error(\"Fichier hors du dossier surveillé : \" + path);\n  }\n\n  const name = path.slice(inbox.length);\n\n  const allowed =\n    /^[\\p{L}\\p{N}_ .()-]+\\.(pdf|mp3|wav|m4a|aac|flac|ogg|opus|wma|mp4|mkv|mov|webm|avi|m4v)$/iu;\n\n  if (\n    !allowed.test(name) ||\n    name.startsWith(\".\") ||\n    name.includes(\"..\")\n  ) {\n    throw new Error(\"Nom ou extension non autorisés : \" + name);\n  }\n\n  const ext = name.split(\".\").pop().toLowerCase();\n  const stem = name.slice(0, name.lastIndexOf(\".\"));\n\n  const executionId = String($execution.id || \"\")\n    .replace(/[^a-zA-Z0-9_-]/g, \"\");\n\n  if (!executionId) {\n    throw new Error(\"Identifiant d'exécution absent.\");\n  }\n\n  const job = executionId + \"_\" + index;\n\n  result.push({\n    json: {\n      path,\n      name,\n      ext,\n      stem,\n      job,\n      audioPath: root + \"/02_temp/\" + job + \".wav\",\n      outputPath: root + \"/03_transcriptions/\" +\n        stem + \"_\" + ext + \"_\" + job + \"_TRANSCRIPTION.md\"\n    },\n    pairedItem: { item: index }\n  });\n}\n\nreturn result;\n"
      },
      "id": "115645f5-b756-4834-953e-02fa7fa07fed",
      "name": "Valider fichier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        176
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ext === \"pdf\" }}",
              "value2": true
            }
          ]
        }
      },
      "id": "4b55f37d-b215-467a-a87f-e8a318a64c28",
      "name": "Est-ce un PDF ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        448,
        176
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.path }}",
        "options": {}
      },
      "id": "dd4145ef-684f-4b78-a44f-6eddae198526",
      "name": "Lire PDF",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        656,
        0
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "8989e70a-40b5-4e52-916c-ffe2e151daa7",
      "name": "Extraire texte PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "command": "={{ 'ffmpeg -nostdin -hide_banner -loglevel error -n -i \"' + $json.path + '\" -vn -ar 16000 -ac 1 -c:a pcm_s16le \"' + $json.audioPath + '\"' }}"
      },
      "id": "dcfe1223-f4b0-488a-b8d9-c5e6bb682b8e",
      "name": "Extraction Audio (FFmpeg)",
