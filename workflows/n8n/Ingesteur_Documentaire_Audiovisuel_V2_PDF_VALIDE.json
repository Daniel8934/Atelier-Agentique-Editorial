      "id": "05611681-bfaf-40fd-96fa-0002060cb4f0",
      "name": "Transcription Whisper Local",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1104,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Valider fichier').first().json;\nconst raw = $input.first().json.text;\nif (typeof raw !== 'string' || !raw.trim()) throw new Error(meta.ext === 'pdf' ? 'PDF sans texte exploitable : OCR requis ou extraction échouée.' : 'Whisper : transcription vide ou réponse incompatible.');\nconst kind = meta.ext === 'pdf' ? 'Extraction PDF' : 'Transcription audio';\nconst markdown = '# '+kind+'\\n\\nSource : '+meta.name+'\\n\\n'+raw.trim()+'\\n';\nreturn [{json:{...meta,markdown},binary:{data:{data:Buffer.from(markdown,'utf8').toString('base64'),mimeType:'text/markdown',fileName:meta.outputPath.split('/').pop()}}}];"
      },
      "id": "47def2b1-b843-4b9a-b5f8-91e7d71634de",
