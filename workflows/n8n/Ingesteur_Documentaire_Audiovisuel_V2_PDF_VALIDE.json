      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://atelier-whisper:8000/v1/audio/transcriptions",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
