        }
      },
      "notes": "Associer le credential Header Auth Dify_Atelier_3 (Authorization: Bearer <clé API>). Contrat provisoire: input_text, glossaire_markdown, audit_logique -> plan_final. Adapter au DSL définitif."
    },
    {
      "parameters": {
        "jsCode": "const d=$input.first().json.data;\nif(d?.status !== 'succeeded') throw new Error('Atelier 3: '+(d?.error || 'exécution non réussie'));\nif(typeof d.outputs?.plan_final !== 'string' || !d.outputs.plan_final.trim()) throw new Error('Sortie plan_final absente (vérifier DSL Atelier 3)');\nreturn [{json:{plan_final:d.outputs.plan_final,audit_logique:$('Contrôler Atelier 2').first().json.audit_logique}}];"
      },
