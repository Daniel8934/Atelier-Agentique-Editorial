    {
      "parameters": {
        "jsCode": "const v=$input.first().json;\nconst s=$('Appliquer mapping validé').first().json;\nconst plan=v['Plan Détaillé'], audit=v['Audit Logique'];\nif(typeof plan!=='string'||!plan.trim()||typeof audit!=='string'||!audit.trim()) throw new Error('Plan ou audit vide');\nconst markdown=['# Dossier de travail éditorial','Mandat : '+s.mandat_id,'Source : '+s.filename,'Date : '+new Date().toISOString(),'## Plan détaillé validé',plan,'## Audit logique validé',audit,'## Glossaire (Atelier 1, avant validation des noms)',s.glossaire_markdown,'## Mapping validé','```json\\n'+JSON.stringify(s.mapping,null,2)+'\\n```','## Transcription normalisée',s.texte_final].join('\\n\\n');\nconst data=await this.helpers.prepareBinaryData(Buffer.from(markdown,'utf8'),s.output.split('/').pop(),'text/markdown');\nreturn [{json:{output:s.output,mandat_id:s.mandat_id},binary:{data}}];"
      },
