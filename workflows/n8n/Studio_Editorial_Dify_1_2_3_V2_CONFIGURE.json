        }
      },
      "notes": "Associer le credential Header Auth Dify_Atelier_2 (Authorization: Bearer <clé API>)."
    },
    {
      "parameters": {
        "jsCode": "const d=$input.first().json.data;\nif(d?.status !== 'succeeded') throw new Error('Atelier 2: '+(d?.error || 'exécution non réussie'));\nif(typeof d.outputs?.audit_logique !== 'string' || !d.outputs.audit_logique.trim()) throw new Error('Sortie audit_logique absente (vérifier DSL Atelier 2)');\nreturn [{json:{audit_logique:d.outputs.audit_logique}}];"
      },
