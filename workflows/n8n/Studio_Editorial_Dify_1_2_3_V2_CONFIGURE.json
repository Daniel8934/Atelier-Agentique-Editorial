      "webhookId": "d4e57deb-bdb4-40f9-8aa5-75107d5448a0"
    },
    {
      "parameters": {
        "jsCode": "const filename = String($input.first().json['Nom du fichier transcription (.md)'] ?? '').trim();\nif (!/^[\\p{L}\\p{N}_ .()-]+\\.md$/iu.test(filename) || filename.startsWith('.') || filename.includes('..') || filename.length > 240) throw new Error('Nom Markdown invalide');\nconst base = \"/home/daniel/projets-agentiques/Atelier-Agentique-Editorial/data\";\nreturn [{json:{filename,path:base+'/03_transcriptions/'+filename,output:base+'/04_mandats/DOSSIER_TRAVAIL_'+$execution.id+'.md',mandat_id:String($execution.id)}}];"
      },
      "name": "Valider fichier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "4af7db3b-5a44-4e4f-bb8e-c6824dd11974",
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.path }}",
        "options": {}
      },
      "name": "Lecture Fichier",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "id": "1c416aa9-b65c-4207-afc0-e380f4e86bdf",
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = await this.helpers.getBinaryDataBuffer(0,'data');\nconst input_text = b.toString('utf8').replace(/^\\uFEFF/,'');\nif (!input_text.trim() || input_text.includes('\\uFFFD')) throw new Error('Transcription vide ou UTF-8 invalide');\nif (input_text.length > 1000000) throw new Error('Transcription trop longue pour le contrat Dify');\nreturn [{json:{...$('Valider fichier').first().json,input_text}}];"
      },
      "name": "Décoder transcription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "ae88ba25-9211-45b3-bbfa-14c1f28c8123",
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://docker-nginx-1/v1/workflows/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({inputs:{input_text:$json.input_text},response_mode:\"blocking\",user:\"daniel-studio\"}) }}",
        "options": {
          "timeout": 300000
        }
      },
      "name": "Appel Atelier 1 (Dify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "f71fb6c0-7475-4e3d-a0fe-26cebaf08fab",
      "position": [
        960,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cf9NGtX2NW7NTs0G",
          "name": "Dify - Atelier 1"
        }
      },
      "notes": "Associer le credential Header Auth Dify_Atelier_1 (Authorization: Bearer <clé API>)."
    },
    {
      "parameters": {
        "jsCode": "const d=$input.first().json.data;\nif(d?.status !== 'succeeded') throw new Error('Atelier 1: '+(d?.error || 'exécution non réussie'));\nconst o=d.outputs;\nif(!o || typeof o.texte_final !== 'string' || typeof o.glossaire_markdown !== 'string' || !o.identites_locuteurs || typeof o.identites_locuteurs !== 'object' || Array.isArray(o.identites_locuteurs)) throw new Error('Contrat Atelier 1 invalide');\nreturn [{json:o}];"
      },
      "name": "Contrôler Atelier 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "e01eeb9d-ee58-4ee6-944d-755487be0598",
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "defineForm": "json",
        "jsonOutput": "={{ JSON.stringify([{fieldLabel:\"Mapping des locuteurs\",fieldType:\"textarea\",requiredField:true,defaultValue:JSON.stringify($json.identites_locuteurs,null,2)}]) }}",
        "options": {
          "formTitle": "Validation des Intervenants",
          "formDescription": "Corriger le mapping JSON puis valider. Utiliser {} en absence de diarisation."
        }
      },
      "name": "Validation Humaine (Noms)",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "id": "ee98ee0e-edfa-4e57-ac1a-656aad74d786",
      "position": [
        1440,
        0
      ],
      "webhookId": "9566f514-ff59-440e-9bb6-1318ad47cca7"
    },
    {
      "parameters": {
        "jsCode": "let mapping;\ntry {mapping=JSON.parse($input.first().json['Mapping des locuteurs']);} catch {throw new Error('Mapping JSON invalide');}\nif(!mapping || typeof mapping !== 'object' || Array.isArray(mapping)) throw new Error('Mapping: objet attendu');\nconst source=$('Décoder transcription').first().json;\nconst ids=new Set(source.input_text.match(/\\bSPEAKER_\\d+\\b/g)||[]);\nfor(const [k,v] of Object.entries(mapping)) if(!ids.has(k)||typeof v!=='string'||!v.trim()||/[\\r\\n]/.test(v)) throw new Error('Mapping invalide: '+k);\nconst texte_final=source.input_text.replace(/\\bSPEAKER_\\d+\\b/g,k=>Object.hasOwn(mapping,k)?mapping[k].trim():k);\nreturn [{json:{...source,texte_final,mapping,glossaire_markdown:$('Contrôler Atelier 1').first().json.glossaire_markdown}}];"
      },
      "name": "Appliquer mapping validé",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "4c130547-e22f-48cb-b7b3-bc839b79dae3",
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://docker-nginx-1/v1/workflows/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({inputs:{input_text:$json.texte_final},response_mode:\"blocking\",user:\"daniel-studio\"}) }}",
        "options": {
